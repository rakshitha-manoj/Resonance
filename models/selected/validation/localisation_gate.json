{
 "meta": {
  "task": "T1 localisation gate",
  "runtime_s": 745.2,
  "excitation_scale_reasoning": {
   "S0_g2_per_Hz": 2.550152793539186e-07,
   "base_rms_mg_in_2_12Hz": 1.5969197830633781,
   "reference_building": {
    "f1_hz": 7.0,
    "zeta": 0.02,
    "target_top_floor_az_std_counts": 173.0
   },
   "level_multiplier": "log-uniform (0.6, 1.7) on base-acceleration amplitude, per building",
   "text": "Base-equivalent ambient excitation (wind/traffic/occupant activity) of about 1.6 mg rms in 2-12 Hz (flat one-sided PSD S0=2.55e-07 g^2/Hz) is amplified by the first-mode resonance (quality factor 1/(2*zeta), 17-50) to an expected roof signal-only az_std of ~173 counts (~10.5 mg rms) for the reference building (f1=7 Hz, zeta=2%). 173 counts is the geometric middle of the required 100-300 count range and sits inside the generator's 'normal' class amplitude (150-500 counts peak = 106-354 rms). S0 is computed analytically from that amplitude target (reference_psd()) and was fixed before any detection result existed; per-building level multiplier 0.6-1.7 plus the f1 and zeta spread give the remaining variation. The same S0 is used for the broadband (2-45 Hz) variant, so broadband has more total power."
  },
  "gx_note": "gx is MODELLED, NOT PHYSICAL (as in generate.py): gain U(0.02,0.2) x floor lateral signal + noise sigma U(5,20) + constant offset N(0,15). Only gx_std and gx_domfreq reach the tree.",
  "az_note": "az = lateral (sway) absolute floor acceleration; counts 16384/g; DLPF 2nd-order Butterworth 44 Hz at 1 kHz (CFG=3 emulation, copied from dlpf_check.py) then decimated to 100 Hz; sensor noise per node sigma U(20,60) added after decimation.",
  "method_fixed_in_advance": {
   "windows_per_assessment": 30,
   "noise_estimate": "separate 30-window noise-only commissioning recording per building: noise_var_k = mean over windows of az_std^2",
   "s_k": "sqrt(max(mean(az_std_k^2) - noise_var_k, 1.0))",
   "ratio": "r_k = s_k/s_(k-1), k=2..10; r_1 = s_1/median(s_1..s_10) (no sensor below storey 1)",
   "baseline": "r0 from a healthy recording of the same building, different excitation seed (exc_id 0 vs 1)",
   "DI": "DI_k = log(r_k/r0_k); predicted storey = argmax|DI_k|; alarm if max|DI_k| > threshold",
   "threshold": "95.0th percentile of max|DI| over 500 healthy calibration buildings (seeds disjoint from scoring); broadband variant recalibrated on 300 broadband healthy buildings",
   "scoring": "100 fresh buildings per storey per damage level (different building seeds per cell); false alarm on 1500 fresh healthy assessments",
   "top1_definition": "unconditional (all damaged buildings regardless of alarm); conditional-on-alarm also reported",
   "pass_criterion": "30% loss, default excitation: top-1 >= 0.70 AND within-one >= 0.90 AND false alarm <= 0.05"
